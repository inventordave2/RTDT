{
  "name": "rtdt-raytracer",
  "version": "2.0.0",
  "description": "Ray tracer CLI with interactive web UI",
  "main": "cli.js",
  "bin": {
    "rtdt": "./cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node cli.js --help",
    "render": "node cli.js --scene scene1 --output render.ppm",
    "render:preview": "node cli.js --scene scene1 --width 150 --height 84 --output preview.ppm",
    "test": "node tests/scene-render-smoke.test.js && node tests/scene-expressions.test.js && node tests/rgb-bmp.test.js && node tests/scene-assets-layout.test.js",
    "test:scene-expressions": "node tests/scene-expressions.test.js",
    "test:scene-assets": "node tests/scene-assets-layout.test.js"
  },
  "keywords": [
    "raytracer",
    "graphics",
    "rendering",
    "cli"
  ],
  "author": "inventordave2",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  }
}
