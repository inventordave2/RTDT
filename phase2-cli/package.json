{
  "name": "rtdt-raytracer",
  "version": "1.0.0",
  "description": "Ray tracer - works in browser and Node.js CLI",
  "main": "cli-bootstrap.js",
  "scripts": {
    "start": "node cli-bootstrap.js",
    "render": "node cli-bootstrap.js --scene scene1 --output render.ppm",
    "render:preview": "node cli-bootstrap.js --scene scene1 --width 150 --height 84 --output preview.ppm",
    "test": "node cli-bootstrap.js --help"
  },
  "keywords": [
    "raytracer",
    "graphics",
    "rendering",
    "cli"
  ],
  "author": "inventordave2",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  }
}
